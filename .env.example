# === MCP Server ===
MCP_SERVER_NAME=salesforce-netsuite
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Static bearer tokens — kept for server-to-server consumers (e.g. Sabueso).
# Read-only access token (required unless OAuth is configured or the insecure
# flag below is set — the server refuses to start with no auth at all).
MCP_API_TOKEN=
# Write access token (required for create/update/delete tools)
MCP_WRITE_TOKEN=
# Set to true ONLY for local dev to run with no auth (every request gets write
# access). Leaving it unset makes a token-less/OAuth-less deploy fail closed.
MCP_ALLOW_INSECURE_NO_AUTH=

# === Logging / usage analytics ===
# Root log level. INFO logs one redacted line per tool call (tool, caller,
# duration, result size, args); set to DEBUG for maximum verbosity.
LOG_LEVEL=INFO
# Where the structured per-tool-call JSONL analytics log is appended. Defaults
# to ./.cache/tool_usage.jsonl. On an ephemeral filesystem (e.g. Railway) point
# this at a mounted volume if you want the JSONL to survive redeploys; stdout is
# always the durable record regardless.
TOOL_USAGE_LOG=

# === OAuth (Google) — required for Claude Desktop "Custom Connector" ===
# Leave OAUTH_GOOGLE_CLIENT_ID unset to disable OAuth entirely. When set,
# all four (CLIENT_ID, CLIENT_SECRET, PUBLIC_URL, SIGNING_KEY) are required.
# Create the Google client at https://console.cloud.google.com/apis/credentials
# (OAuth 2.0 Client ID, type "Web application"); add the redirect URI
# https://<your-public-host>/oauth/callback.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# Public URL of this server, no trailing slash (e.g. https://agent-b.up.railway.app).
# Used as the OAuth issuer + resource server URL and to build the Google
# callback URL. MUST match what's registered in the Google Cloud Console.
OAUTH_PUBLIC_URL=
# Random ≥32-char secret used to sign access-token JWTs (HS256). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
OAUTH_SIGNING_KEY=
# Restrict to a single Google Workspace domain (recommended). Leave blank to
# permit any verified Google account that gets past the consent screen.
OAUTH_ALLOWED_DOMAIN=
# Comma-separated emails that get the agent-b:write scope. Everyone else who
# passes the domain check gets read-only. Edit + restart to revoke.
OAUTH_WRITE_EMAILS=
# Escape hatch: comma-separated emails allowed regardless of the domain check.
# Use for occasional outside collaborators or your own personal Google account.
# Requires the OAuth consent screen to be External (Internal blocks them at
# Google's sign-in step before this list is ever consulted).
OAUTH_EXTRA_ALLOWED_EMAILS=
# Where the OAuth server persists its state (registered Claude Desktop clients +
# refresh tokens). Without this, that state lives in process memory and is wiped
# on every container restart/deploy — forcing users to reconnect. Set it to a
# Redis URL (Railway's Redis plugin injects REDIS_URL automatically) so
# connections survive deploys. Leave blank for local dev / single-instance use.
REDIS_URL=

# === Salesforce (OAuth 2.0 Refresh Token) ===
SF_CLIENT_ID=your_connected_app_client_id
SF_CLIENT_SECRET=your_connected_app_client_secret
# Set to "test" for sandbox, leave empty for production
SF_DOMAIN=

# === NetSuite (TBA — OAuth 1.0) ===
NETSUITE_ACCOUNT_ID=YOUR_ACCOUNT_ID
NETSUITE_TBA__CONSUMER_KEY=your_consumer_key
NETSUITE_TBA__CONSUMER_SECRET=your_consumer_secret
NETSUITE_TBA__TOKEN_KEY=your_token_key
NETSUITE_TBA__TOKEN_SECRET=your_token_secret

# === Pardot / Account Engagement (uses Salesforce OAuth) ===
PARDOT_BUSINESS_UNIT_ID=your_pardot_business_unit_id
# Pardot: a curated subset of read tools is always live. Set to true/1/yes to
# expose the FULL Pardot surface (all 74 read + 54 write tools); leave blank for
# the lean curated-read default.
PARDOT_TOOLS_ENABLED=

# === OPERA PMS (via opera-pms-api, read-only) ===
# OPERA is reached through the opera-pms-api HTTP service (a thin Go service on
# the TVOMCORP network, next to the OPERA DB), exposed to this deployment over a
# tunnel (Tailscale / Cloudflare). src/opera_client.py POSTs read-only SQL to it;
# we no longer connect to Oracle directly from here (the old OPERA_DB_* vars and
# the oracledb driver are retired).
OPERA_API_BASE_URL=
OPERA_API_TOKEN=
# On Railway, the service is reached over a Tailscale userspace SOCKS5 tunnel
# (start.sh brings it up when TS_AUTHKEY is set). Route ONLY the OPERA call
# through it; leave other upstreams direct. socks5h:// resolves the MagicDNS
# name at the tailscaled end. Leave blank for a direct route (local dev).
OPERA_API_PROXY=socks5h://localhost:1055
# Tailscale auth key for the container to join the @vinesofmendoza.com tailnet
# (admin console -> Settings -> Keys; reusable + ephemeral + tagged).
TS_AUTHKEY=
# OPERA MCP tools are OFF by default. Set to true/1/yes to register them once
# OPERA_API_BASE_URL/OPERA_API_TOKEN are set and the service is reachable.
# Cross-system composites that touch OPERA degrade gracefully regardless.
OPERA_TOOLS_ENABLED=
